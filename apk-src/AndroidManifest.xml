<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.wb2api"
    android:versionCode="12603"
    android:versionName="1.26.3">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- dataSync 那份留着：老版本系统/回落路径可能用到（本机 Android 16，用 specialUse） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wi-Fi 高性能锁：局域网连过来的场景，屏灭后 Wi-Fi 省电/休眠会把连接掐掉 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 「显示在其他应用上层」：用来挂 1x1 全透明的常驻图层 → 系统不把我判成缓存态、不进
         app-freezer（"过一会儿连不上、拉回前台就好"的那个坑） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确 alarm：能精确就精确（Doze 里 setAndAllowWhileIdle 会被从 5 分钟拖到 ~9 分钟一次）。
         用户没授予"闹钟与提醒"时，代码自动回落非精确，不会崩。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 申请"忽略电池优化"：不申请的话 Doze 会掐网络、把 alarm 推后到 9 分钟以上 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- extractNativeLibs=true: 让安装器把 lib/arm64-v8a/libwb2api.so 解到
         nativeLibraryDir（那里 SELinux 允许读取/加载，且可能带 x 位） -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 类型用 specialUse 而不是 dataSync：dataSync 在 Android 15+ 有 6 小时/天上限，
             对一个要 7×24 常驻的自托管网关是致命的（到点被系统掐掉）
             stopWithTask=false：任务列表被划掉也不停服务（不然一划就没） -->
        <service
            android:name=".GatewayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="self-hosted local API gateway (workbuddy2api) must run continuously" />
        </service>

        <!-- 看门狗第五层：JobScheduler 周期兜底（系统托管、跨重启仍在） -->
        <service
            android:name=".ReviveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 看门狗第三层：开机/更新后自启（BOOT_COMPLETED 是受保护广播，只有系统能发） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
